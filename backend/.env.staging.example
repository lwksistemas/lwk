# Beta isolado (201.54.18.213). Não use DATABASE_URL de produção.
# Modelo completo: .env.beta.example
#
# API local contra o Postgres do beta:
#   cd backend
#   set -a && source ../.env.staging && set +a
#   python manage.py runserver

DATABASE_URL=

DJANGO_SETTINGS_MODULE=config.settings_production

ALLOWED_HOSTS=localhost,127.0.0.1,beta.lwksistemas.com.br

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://beta.lwksistemas.com.br

USE_REDIS=false
