FROM node:22-alpine AS builder
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY frontend/ .
ARG LWK_FRONTEND_APP=all
ARG NEXT_PUBLIC_API_URL=https://api.lwksistemas.com.br
ARG NEXT_PUBLIC_JWT_HTTPONLY_COOKIES=true
ENV LWK_FRONTEND_APP=${LWK_FRONTEND_APP}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_JWT_HTTPONLY_COOKIES=${NEXT_PUBLIC_JWT_HTTPONLY_COOKIES}
RUN node scripts/recortar-rotas-app.mjs && npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
RUN chown -R node:node /app
USER node
EXPOSE 3000
CMD ["node", "server.js"]
