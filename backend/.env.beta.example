# Servidor beta isolado (201.54.18.213) — NÃO copie .env de produção.
# Lojas e clientes de teste apenas. Sandbox nas integrações financeiras.

DEBUG=false
DJANGO_SETTINGS_MODULE=config.settings_production
LWK_ENVIRONMENT=staging
EVOLUTION_DEDICATED=true
USE_REDIS=true
USE_TASK_QUEUE=true
USE_FORWARDED_SSL=true
LWK_DISABLE_SSL_REDIRECT=true
FORWARDED_ALLOW_IPS=*

ALLOWED_HOSTS=beta.lwksistemas.com.br,127.0.0.1,localhost
CORS_ORIGINS=https://beta.lwksistemas.com.br
SITE_URL=https://beta.lwksistemas.com.br
API_BASE_URL=https://beta.lwksistemas.com.br
FRONTEND_URL=https://beta.lwksistemas.com.br
FIELD_ENCRYPTION_KEY_FILE=/etc/lwk-encryption.key

# Preenchidos pelo compose
# DATABASE_URL=
# REDIS_URL=
# POSTGRES_PASSWORD=

# Mídia local no próprio beta (não use media.lwksistemas.com.br)
MEDIA_SERVER_URL=https://beta.lwksistemas.com.br
MEDIA_API_TOKEN=

# WhatsApp — Evolution só deste servidor. Celular de TESTE, nunca o da clínica real.
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_URL=https://beta.lwksistemas.com.br/api/whatsapp/evolution/webhook/

# PACS isolado (AE LWKBETAPACS, IP do servidorbeta)
ORTHANC_URL=http://orthanc:8042
ORTHANC_USER=lwk
ORTHANC_PASSWORD=
ORTHANC_WORKLISTS_DIR=/var/lib/orthanc/worklists
ORTHANC_DICOM_AET=LWKBETAPACS
ORTHANC_DICOM_HOST=201.54.18.213
ORTHANC_DICOM_PORT=4242
RADIOLOGIA_DICOM_UID_ROOT=1.2.826.0.1.3680043.10.742.2

# Financeiro / receita: sandbox ou vazio. Nunca chave live da Felix.
ASAAS_SANDBOX=true
ASAAS_API_KEY=
MEMED_ENVIRONMENT=integration
MEMED_API_KEY=
MEMED_SECRET_KEY=
