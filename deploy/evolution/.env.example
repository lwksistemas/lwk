# Evolution API — variáveis da VM dedicada
# Copie para .env e preencha. NUNCA versione o .env real.
#
#   cp .env.example .env && nano .env

# Chave de autenticação da Evolution.
# IMPORTANTE: use EXATAMENTE a mesma chave que já está no .env do servidor LWK
# (EVOLUTION_API_KEY em /opt/lwk-erp/.env). Assim o backend não precisa trocar nada.
EVOLUTION_API_KEY=

# Senha do Postgres local desta VM (gere uma forte e aleatória).
# Ex.: openssl rand -base64 24
PG_PASS=
